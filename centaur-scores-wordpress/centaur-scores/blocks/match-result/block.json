{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "centaur-scores/match-result",
	"title": "Centaur Scores Match Result",
	"category": "widgets",
	"icon": "chart-bar",
	"description": "Embed the live results of a single Centaur Scores match.",
	"textdomain": "centaur-scores",
	"attributes": {
		"tenantId": { "type": "string", "default": "" },
		"matchId": { "type": "string", "default": "" },
		"scope": { "type": "string", "default": "" },
		"columns": { "type": "number", "default": 1 }
	},
	"supports": {
		"html": false,
		"className": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "centaur-scores-match-result-editor",
	"style": "centaur-scores-frontend"
}
