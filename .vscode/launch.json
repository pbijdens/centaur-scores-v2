{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API (Development)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-api",
            "program": "${workspaceFolder}/centaur-scores-api-v2/CentaurScores.Api/bin/Debug/net10.0/CentaurScores.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/centaur-scores-api-v2/CentaurScores.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5080"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/centaur-scores-api-v2/Views"
            }
        },
        {
            // Starts the Vite dev server inside WSL (npm/node only live there) and opens Edge on it.
            "name": "Web UI (Development)",
            "type": "msedge",
            "request": "launch",
            "preLaunchTask": "dev-web-ui",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/centaur-scores-web-ui"
        },
        {
            // The scorekeeper needs ?api=<scorekeeper url>&language=NL|EN to do anything useful;
            // copy the query string from a device link on the web UI's QR codes page
            // (those links point at <web-ui-origin>/scores, which only exists in production).
            "name": "Scorekeeper (Development)",
            "type": "msedge",
            "request": "launch",
            "preLaunchTask": "dev-scorekeeper",
            "url": "http://localhost:5174",
            "webRoot": "${workspaceFolder}/centaur-scores-mobile-web-scoring"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
