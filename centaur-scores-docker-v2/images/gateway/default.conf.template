server {
    listen 80;
    listen [::]:80;
    server_name _;
    absolute_redirect off;

    root /usr/share/nginx/html;
    index index.html;

    location ^~ ${PUBLIC_API_VDIR} {
        proxy_pass http://api:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ ${PUBLIC_APP_VDIR} {
        try_files $uri $uri/ ${PUBLIC_APP_VDIR}index.html;
    }

    # Published results (/results/{slug}) are public but must never be indexed: send X-Robots-Tag before any
    # JavaScript runs. "rewrite ... break" (rather than try_files) serves the SPA's index.html from THIS location,
    # so the header applies.
    location ^~ /results/ {
        add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
        rewrite ^ /index.html break;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
