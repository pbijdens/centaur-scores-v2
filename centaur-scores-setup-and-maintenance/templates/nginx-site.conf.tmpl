# Managed by centaur-scores-setup-and-maintenance.
#
# IMPORTANT: after setup/09-obtain-tls-certificate.sh has run, certbot has
# added a "listen 443 ssl;" server block (and an https redirect) to this
# file. Do not blindly re-render this file after that point - it will wipe
# out certbot's changes. Routine traffic-split changes only touch
# /etc/nginx/conf.d/centaur-scores-upstreams.conf via update/set-traffic.sh,
# update/promote.sh and update/rollback.sh, and never touch this file.

server {
    listen 80;
    listen [::]:80;
    server_name ${PUBLIC_HOSTNAME};
    absolute_redirect off;

    access_log ${CENTAUR_LOG_DIR}/nginx-access.log;
    error_log  ${CENTAUR_LOG_DIR}/nginx-error.log;

    # Sticky assignment: pin this visitor to the blue/green variant chosen in
    # centaur-scores-upstreams.conf for 30 days so their session never flips
    # mid-way between the two versions.
    add_header Set-Cookie "csv_slot=$centaur_scores_variant; Path=/; Max-Age=2592000; SameSite=Lax" always;

    root $centaur_scores_webroot;
    index index.html;

    # A bare vdir with no trailing slash (e.g. a QR code linking to
    # "${PUBLIC_APP_VDIR_NOSLASH}?api=...") is one character short of the
    # "^~ ${PUBLIC_APP_VDIR}" prefix below and would otherwise fall through
    # to "location /" and serve the wrong app. Redirect it to the
    # trailing-slash form first, preserving the query string.
    location = ${PUBLIC_API_VDIR_NOSLASH} {
        return 301 ${PUBLIC_API_VDIR}$is_args$args;
    }
    location = ${PUBLIC_APP_VDIR_NOSLASH} {
        return 301 ${PUBLIC_APP_VDIR}$is_args$args;
    }

    location ^~ ${PUBLIC_API_VDIR} {
        # proxy_pass's target is a variable (it picks blue vs. green), and
        # nginx does NOT do its usual "strip the matched location prefix"
        # rewrite when the proxy_pass URI comes from a variable - it would
        # otherwise forward "/" for every request, regardless of the actual
        # path. Strip the vdir ourselves first, then proxy_pass with no URI
        # of its own so the already-rewritten $uri is forwarded unchanged.
        rewrite ^${PUBLIC_API_VDIR}(.*)$ /$1 break;
        proxy_pass $centaur_scores_api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ ${PUBLIC_APP_VDIR} {
        alias $centaur_scores_scoringroot/;
        try_files $uri $uri/ ${PUBLIC_APP_VDIR}index.html;
    }

    # Pre-built Android APKs, refreshed from GitHub releases by
    # update/update-android-assets.sh - not part of the blue/green slots,
    # served as plain static files with their own, separate update cycle.
    location ^~ /android/ {
        alias ${CENTAUR_BASE_DIR}/android/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
