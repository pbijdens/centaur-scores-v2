#!/bin/bash
# Managed by centaur-scores-setup-and-maintenance - do not edit by hand.
# Regenerated by setup/08-render-service-configs.sh.
#
# logrotate (centaur-scores-api / centaur-scores-nginx) enforces the 16MB
# per-file cap and the 90-day max age. This script enforces the extra,
# total-folder budget: once /srv/centaur-scores/logs exceeds 1 GiB, the
# oldest compressed/rotated logs are deleted first until it's back under
# budget. Live *.log files are never touched here.
set -euo pipefail

LOG_DIR="${CENTAUR_LOG_DIR}"
BUDGET_BYTES=${LOG_TOTAL_BUDGET_BYTES}

total_bytes() { du -sb "${LOG_DIR}" 2>/dev/null | cut -f1; }

total="$(total_bytes)"
[[ -z "${total}" ]] && exit 0
(( total <= BUDGET_BYTES )) && exit 0

find "${LOG_DIR}" -maxdepth 1 -type f -name '*.gz' -printf '%T@\t%p\n' | sort -n | cut -f2- | \
while IFS= read -r file; do
    total="$(total_bytes)"
    (( total <= BUDGET_BYTES )) && break
    rm -f -- "${file}"
    logger -t centaur-scores-log-prune "removed ${file} to stay under ${BUDGET_BYTES}-byte log folder budget"
done

total="$(total_bytes)"
if (( total > BUDGET_BYTES )); then
    logger -t centaur-scores-log-prune "WARNING: ${LOG_DIR} is ${total} bytes (budget ${BUDGET_BYTES}) even after removing all compressed logs - live logs alone exceed the budget."
fi
