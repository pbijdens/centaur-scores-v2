# Managed by centaur-scores-setup-and-maintenance - do not edit by hand.
# Regenerated by update/set-traffic.sh, update/promote.sh and update/rollback.sh.
#
# Picks a "variant" (blue or green) per visitor: existing visitors keep the
# slot recorded in their csv_slot cookie, new visitors are assigned by the
# split_clients percentage below and get the cookie set (see the site config).
# The chosen variant then decides which release directories and which API
# backend that visitor's requests are served from, so a given browser always
# gets a consistent pairing of frontend + API version.

upstream centaur_scores_api_blue {
    server 127.0.0.1:${API_BLUE_PORT};
}

upstream centaur_scores_api_green {
    server 127.0.0.1:${API_GREEN_PORT};
}

split_clients "$remote_addr$http_user_agent$request_time" $centaur_scores_split {
${SPLIT_CLIENTS_RULES}
}

map $cookie_csv_slot $centaur_scores_variant {
    default              $centaur_scores_split;
    "~^(blue|green)$"    $cookie_csv_slot;
}

map $centaur_scores_variant $centaur_scores_webroot {
    blue    ${CENTAUR_BASE_DIR}/releases/web-ui/blue;
    green   ${CENTAUR_BASE_DIR}/releases/web-ui/green;
}

map $centaur_scores_variant $centaur_scores_scoringroot {
    blue    ${CENTAUR_BASE_DIR}/releases/scoring/blue;
    green   ${CENTAUR_BASE_DIR}/releases/scoring/green;
}

map $centaur_scores_variant $centaur_scores_api_upstream {
    blue    http://centaur_scores_api_blue;
    green   http://centaur_scores_api_green;
}
