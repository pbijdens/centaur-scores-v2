# -----------------------------------------------------------------------------
# centaur-scores-setup-and-maintenance / config.env
#
# Copy this file to config.env (same directory) and fill in real values:
#   cp config.env.example config.env
#   chmod 600 config.env
#
# config.env contains secrets (DB password, JWT secret). It must never be
# committed to git (it is already covered by .gitignore in this folder) and
# should stay readable only by root on the server.
# -----------------------------------------------------------------------------

### Public hostname & URL layout ##############################################

# The single public hostname nginx terminates TLS for and that certbot
# requests a Let's Encrypt certificate for. Point DNS (A/AAAA record) at this
# VPS before running setup/09-obtain-tls-certificate.sh.
PUBLIC_HOSTNAME="archeryscores.net42.org"

# Email address certbot registers with Let's Encrypt for expiry/urgency mail.
LETSENCRYPT_EMAIL="pieter-bas@ijdens.com"

# Virtual directories the API and the mobile scoring app are hosted under.
# Must start and end with '/'. The web-ui is always hosted at '/'.
PUBLIC_API_VDIR="/api/"
PUBLIC_APP_VDIR="/scores/"

### Source ######################################################################

# The three components live in this one monorepo; deploys clone a single
# branch and build all three from it together.
GITHUB_REPO_URL="https://github.com/pbijdens/centaur-scores-v2.git"

### Runtime layout ##############################################################

CENTAUR_BASE_DIR="/srv/centaur-scores"
CENTAUR_SERVICE_USER="centaur-scores"
CENTAUR_SERVICE_GROUP="centaur-scores"

# Loopback ports each slot's API instance listens on. Never exposed publicly -
# nginx is the only thing that ever talks to these.
API_BLUE_PORT="5101"
API_GREEN_PORT="5102"

# How many previous builds to keep on disk per slot per component, for quick
# manual rollback / inspection. Older ones are pruned automatically on deploy.
RELEASES_TO_KEEP="3"

### Database (MariaDB, installed locally by setup/05-install-mysql.sh) #########

MYSQL_DATABASENAME="csdb"
MYSQL_USERNAME_APP="csuser"
MYSQL_PASSWORD_APP="replace-with-a-strong-application-password"

### Application secrets ##########################################################

# At least 32 random characters, e.g.: openssl rand -hex 32
JWT_SECRET="replace-with-at-least-32-random-characters"

### Logging #######################################################################

CENTAUR_LOG_DIR="${CENTAUR_BASE_DIR}/logs"
LOG_MAX_FILE_SIZE="16M"
LOG_RETENTION_DAYS="90"
LOG_TOTAL_BUDGET_BYTES="1073741824"   # 1 GiB - oldest rotated/compressed logs are deleted past this
